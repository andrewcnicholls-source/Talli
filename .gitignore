# Written at deploy time by scripts/build.sh, on non-production builds
# only. Never committed: which one you get depends on the branch.
/robots.txt
/_headers

# Skill bundles built by scripts/package-skills.sh for upload to a
# Claude account. Rebuildable; the SKILL.md files are the source.
/dist/

# Scratch state written by the Supabase CLI (version-check cache and
# linked-project markers). Recreated on demand; never part of a deploy.
/supabase/.temp/
